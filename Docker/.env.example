# Server
VERDICT_SECRET_KEY=
VERDICT_PORT=8000
# Use an absolute path on ZimaOS, writable by UID/GID 1000:1000.
VERDICT_DATA_PATH=./data
VERDICT_ALLOWED_HOSTS=localhost,127.0.0.1
VERDICT_CSRF_TRUSTED_ORIGINS=
VERDICT_TRUST_PROXY=0
VERDICT_SECURE_COOKIES=0

# Client (use the server's LAN IP or public URL, not localhost).
USERNAME=
PASSWORD=
SERVER=http://192.168.50.2:8000
